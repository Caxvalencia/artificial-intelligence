{
  "name": "artificial-intelligence",
  "version": "0.0.1",
  "description": "",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "nyc ts-mocha --timeout 0 -r source-map-support/register --recursive src/tests/*-test.ts",
    "test-file": "nyc ts-mocha --timeout 0 -r source-map-support/register --recursive ",
    "dev": "pnpm run development",
    "development": "cross-env NODE_ENV=development webpack --progress --config=webpack.config.js",
    "watch": "cross-env NODE_ENV=development webpack --watch --progress --config=webpack.config.js",
    "prod": "pnpm run production",
    "production": "cross-env NODE_ENV=production webpack --progress --config=webpack.config.js",
    "demo": "pnpm dev && http-server demo/ -p 6767 -o",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "nyc": {
    "extension": [
      ".ts",
      ".tsx"
    ],
    "exclude": [
      "**/*.d.ts",
      "**/*.js"
    ],
    "reporter": [
      "text"
    ],
    "all": true
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tensorflow/tfjs-node"
    ],
    "overrides": {
      "diff": "^8.0.3",
      "serialize-javascript": "^7.0.3",
      "tar": "^7.5.11",
      "uuid": "^11.1.1"
    },
    "patchedDependencies": {
      "@tensorflow/tfjs-node@4.22.0": "patches/@tensorflow__tfjs-node@4.22.0.patch"
    }
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-node": "^4.22.0"
  },
  "devDependencies": {
    "@testdeck/mocha": "0.3.3",
    "@types/chai": "^4.3.20",
    "@types/node": "^25.9.1",
    "@types/sinon": "^21.0.1",
    "chai": "^4.5.0",
    "cross-env": "^10.1.0",
    "http-server": "^14.1.1",
    "mocha": "^11.7.6",
    "nyc": "^18.0.0",
    "prettier": "3.8.3",
    "sinon": "^22.0.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.6.0",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  }
}
